---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/rent-check/" title="Embed the rent check" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the rent check: free iframe code for your website" description="Embed the German rent check free of charge: reference rent, rent brake and increase cap for every municipality, no sign-up, no cookies, everything runs in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Start', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the rent check</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up and no cost. The iframe loads the full rent check from this site, with reference rents for Berlin and Hamburg and the rules of every municipality under a tenant-protection ordinance.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link below the calculator stays visible, the calculator is not altered and comes without warranty. We maintain the rent indexes and ordinances here, so your embed stays current. German version: <code>{`${SITE_URL}/embed/mietcheck/`}</code>.</p>
    <p>Your readers' inputs stay on their device; the embedded frame sets no cookies. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/rent-check/" title="Embed the rent check" width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
