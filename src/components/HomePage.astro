---
/**
 * Accueil (page pilier, RECETTE §5) : le Mietcheck d'abord (premier écran), puis le bloc citable replié,
 * la carte des règles par Land (tableau généré depuis les Verordnungen), les Mietspiegel des villes
 * avec l'état des droits de reprise, les autres outils, le texte. Texte : src/content/accueil.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MietCheck from './calc/MietCheck';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { LAENDER_VO } from '../lib/engine/gebiet';
import { STAEDTE } from '../lib/engine/staedte';
import { displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../data/site-config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const de = lang === 'de';
const x = HOME[lang];
const h = helpers(lang);
const path = route('home', lang);
const keys: SourceKey[] = ['bgb556d', 'bgb556g', 'bgb558', 'bgb558d', 'bgb559', 'bgb556', 'betrkv', 'berlinMs', 'vpi'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const methodHref = route('method', lang);
const d = (iso: string) => displayDate(iso, LANG_TAGS[lang]);
const has = (id: string) => ROUTES.some((r) => r.id === id);
const landPage = (code: string) => { const id = `mpb-${code.toLowerCase()}`; return has(id) ? route(id, lang) : null; };
const stadtPage = (id: string) => (has(`mietspiegel-${id}`) ? route(`mietspiegel-${id}`, lang) : null);
const n = (v: { gemeinden: string[] } | null) => (v ? v.gemeinden.length : 0);
const tools = ['mietpreisbremse-rechner', 'mieterhoehung-rechner', 'nebenkostenabrechnung-pruefen', 'indexmiete-rechner', 'mietminderung-rechner', 'kaution-rechner', 'kuendigungsfrist-rechner', 'modernisierung-rechner', 'co2-kosten-rechner'].filter(has);
const parts = x.body(h).split(/<!--mini:([A-Za-z0-9_]+)-->/);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">{de ? 'Mietspiegel, Verordnungen, BGB: ein Rechner' : 'Rent index, ordinances, Civil Code: one calculator'}</p>
    <h1 class="mt-1 text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-2 text-sm text-navy-700">{de ? 'Aktualisiert am' : 'Updated on'} <time datetime={LAST_UPDATED}>{d(LAST_UPDATED)}</time> · <a href={route('about', lang)} class="underline">{label('about', lang)}</a> · <a href={methodHref} class="underline">{label('method', lang)}</a> · <a href={P.sources.bgb556d.url} class="underline" rel="nofollow noopener" target="_blank">§ 556d BGB</a> · <a href={P.sources.berlinMs.url} class="underline" rel="nofollow noopener" target="_blank">{de ? 'Berliner Mietspiegel' : 'Berlin rent index'}</a></p>
  </header>
  <section aria-label={de ? 'Mietcheck' : 'Rent check'}>
    <MietCheck client:load lang={lang} methodHref={methodHref} />
  </section>
  <Clamp text={x.resume} lang={lang} id="clamp-home" sentences={1} class="mt-6 mb-2" />
  <section class="mt-8">
    <h2 class="text-2xl font-bold text-navy-900">{de ? 'Wo die Mietpreisbremse und die Kappungsgrenze von 15 Prozent gelten' : 'Where the rent brake and the 15 per cent cap apply'}</h2>
    <p class="mt-2 text-navy-800">{de ? `Stand der Landesverordnungen am ${d(P.retrieved_at)}. Die Zahl nennt die Gemeinden, die eine Verordnung ganz oder teilweise erfasst; das Datum, wann sie außer Kraft tritt.` : `State ordinances as of ${d(P.retrieved_at)}. The number counts the municipalities an ordinance covers in whole or in part; the date shows when it expires.`}</p>
    <div class="not-prose my-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-navy-300 text-left text-xs uppercase tracking-wide text-navy-700"><th scope="col" class="py-2 pr-3">{de ? 'Land' : 'State'}</th><th scope="col" class="py-2 pr-3">{de ? 'Mietpreisbremse' : 'Rent brake'}</th><th scope="col" class="py-2">{de ? 'Kappungsgrenze 15 %' : '15% cap'}</th></tr></thead>
        <tbody>{LAENDER_VO.map((l) => (
          <tr class="border-b border-navy-100">
            <td class="py-2 pr-3 text-navy-900">{landPage(l.code) ? <a href={landPage(l.code)!} class="underline">{l.name}</a> : l.name}</td>
            <td class="tabular-nums py-2 pr-3 text-navy-800">{l.mpb ? `${n(l.mpb)} ${de ? (n(l.mpb) === 1 ? 'Gemeinde' : 'Gemeinden') : (n(l.mpb) === 1 ? 'municipality' : 'municipalities')} · ${de ? 'bis' : 'until'} ${d(l.mpb.bis)}` : (de ? 'keine Verordnung' : 'no ordinance')}</td>
            <td class="tabular-nums py-2 text-navy-800">{l.kappung ? `${n(l.kappung)} · ${de ? 'bis' : 'until'} ${d(l.kappung.bis)}` : (de ? 'überall 20 %' : '20% everywhere')}</td>
          </tr>))}</tbody>
      </table>
    </div>
  </section>
  <section class="mt-8">
    <h2 class="text-2xl font-bold text-navy-900">{de ? 'Mietspiegel der großen Städte' : 'Rent indexes of the large cities'}</h2>
    <p class="mt-2 text-navy-800">{de ? 'Wo die Stadt die Werte frei veröffentlicht, rechnet der Mietcheck die Vergleichsmiete selbst. Wo sie sich alle Rechte vorbehält, verlinken wir ihren offiziellen Rechner und rechnen mit Ihrem Wert weiter.' : 'Where the city publishes its figures freely, the rent check works out the reference rent itself. Where it reserves all rights, we link its official tool and continue with your figure.'}</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {STAEDTE.map((s) => (
        <li class="rounded-lg border border-navy-200 p-3">
          <p class="font-semibold text-navy-900">{stadtPage(s.id) ? <a href={stadtPage(s.id)!} class="underline">{s.name}</a> : s.name}</p>
          <p class="text-sm text-navy-700">{s.ausgabe}{s.gueltigAb ? ` · ${de ? 'ab' : 'from'} ${d(s.gueltigAb)}` : ''}</p>
          <p class="text-sm text-navy-700">{s.schema === 'eingabe' ? (de ? 'Wert aus dem städtischen Rechner eintragen' : 'Enter the figure from the city tool') : (de ? 'Vergleichsmiete wird hier berechnet' : 'Reference rent calculated here')}{s.kennzahl ? ` · ${de ? 'Mittel' : 'average'} ${h.num(s.kennzahl, 2)} €/m²` : ''}</p>
        </li>))}
    </ul>
  </section>
  <nav class="mt-8" aria-label={de ? 'Weitere Rechner' : 'More calculators'}>
    <h2 class="text-2xl font-bold text-navy-900">{de ? 'Jede Frage zur Miete, ein eigener Rechner' : 'Every rent question has its own calculator'}</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-3">{tools.map((id) => <li><a href={route(id, lang)} class="block rounded border border-navy-200 px-3 py-2 text-navy-900 hover:border-accent-400">{label(id, lang)}</a></li>)}</ul>
  </nav>
  <div class="prose prose-slate mt-8 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : null)}
  </div>
  <p class="mt-6 text-sm text-navy-700">{de ? 'Stand der Daten:' : 'Data as of:'} <time datetime={LAST_UPDATED}>{d(LAST_UPDATED)}</time> · {de ? 'Verbraucherpreisindex bis' : 'Consumer price index up to'} {Object.keys(P.vpi.werte).sort().pop()}</p>
</PageLayout>
